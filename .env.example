# Application
APP_NAME="Lijnet (ልጅነት)"
APP_ENV="development"
SECRET_KEY="change-this-to-a-long-random-hex-secret-in-production"
BASE_URL="http://127.0.0.1:8000"

# PostgreSQL (Update user/password/db to match your local PostgreSQL instance)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/lijnet_db"

# Chapa Payment Gateway (https://developer.chapa.co)
CHAPA_SECRET_KEY="CHASECK_TEST-replace-with-your-chapa-test-key"
CHAPA_WEBHOOK_SECRET="replace-with-your-chapa-webhook-secret"
CHAPA_BASE_URL="https://api.chapa.co/v1"

# Telebirr Direct Merchant (Ethio Telecom)
TELEBIRR_APP_ID="replace-with-telebirr-app-id"
TELEBIRR_APP_KEY="replace-with-telebirr-app-key"
TELEBIRR_SHORT_CODE="replace-with-short-code"
TELEBIRR_PUBLIC_KEY="replace-with-public-key"
TELEBIRR_BASE_URL="https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway"

# SantimPay Gateway
SANTIMPAY_MERCHANT_ID="replace-with-santimpay-merchant-id"
SANTIMPAY_PRIVATE_KEY="replace-with-santimpay-private-key"
SANTIMPAY_BASE_URL="https://services.santimpay.com/api/v1/gateway"